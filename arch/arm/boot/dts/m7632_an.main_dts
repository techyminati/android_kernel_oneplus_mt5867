/dts-v1/;
/include/ "m7632.dtsi"
/include/ "mt5896_mmap.dtsi"
/include/ "m7632_extcon_headset.dtsi"

/ {
	chosen {
		bootargs = "root=/dev/mmcblk0p4 rootfstype=ext4 rw rootwait init=/sbin/init ip=dhcp console=ttyS0,115200,LX_MEM=0x02000000";
		};

	reserved-memory {
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		ranges;

		iommu_reserved: iommu_mem@3CA00000 {
			compatible = "iommu_ion,carveout";
			reg = <0x0 0x3CA00000 0x0 0x6400000>;
		};

	};
	Mstar-sys {
		firmware {
			audio {
				path = "/vendor/lib/utopia/audio_bin/";
			};
			vdec_fw {
				path = "/vendor/lib/utopia/vdec_bin/";
			};
		};
	};

	firmware: firmware {
		optee {
			compatible = "linaro,optee-tz";
			method = "smc";
		};

		android {
			compatible = "android,firmware";
			hardware ="m7632";
			revision ="1234";
			Serial   ="0000000000000000";
			Processor ="AArch32 Processor rev 3 (aarch32)";
			mode ="123456789";
			baseband ="123456789";
		};
	};

	/* example of consume a gpio pin with mapped irq
	foo{
		interrupt-parent = <&gpio>;
		interrupts = <0 LEVEL_HIGH>;
	}
	*/

	gpio: gpio {
		compatible = "mstar,gpio";
		gpio-controller;
		#gpio-cells = <1>;
		interrupt-controller;
		skip-save-status = <6 44 4>;
		#interrupt-cells = <2>; /* cell name GPIO_PAD, trigger-type*/
	};

	soc_m7632_switch:switch_gpio {
		compatible = "mstar,switch-gpio";
		switch-name = "h2w";
		switch-gpio = <66>;
		switch-inverse = <0>;
	};

	soc_m7632_wifi:gpio_wifi_ctl {
		compatible = "mstar,gpio-wifi-ctl";
		wifi-ctl-gpio = <17>;
		wifi-ctl-invert = <1>;
		wifi-ctl-delayms = <100>;
		wifi-ctl-powerdown = <0>;
		wifi-power-ctl-gpio = <52>;
		wifi-power-ctl-invert = <0>;
		wifi-power-ctl-delayms = <100>;
	};

	soc_m7632_backlight: backlight {
		compatible = "backlight";
		brightness-levels = <0 255>;
		default-brightness-level = <255>;
		bl_ctrl = <6>;
		bl_ctrl_inverse = <0>;
		vcc_gpio = <44>;
		vcc_gpio_invert = <0>;
		led_gpio = <4>;
		led_gpio_invert = <0>;
		/* led-pwm-control-support; */
		/* led-pwm-control-channel = <0>; */
		/* led-pwm-control-resume-period = <0xb71a>; */
		/* led-pwm-control-resume-duty = <0xb71a>; */
		/* led-pwm-control-resume-div = <0xff>; */
		/* led-pwm-control-resume-polarity = <0>; */
		/* led-pwm-control-suspend-period = <0xb71a>; */
		/* led-pwm-control-suspend-duty = <0xb71a>; */
		/* led-pwm-control-suspend-div = <0xff>; */
		/* led-pwm-control-suspend-polarity = <0>; */
	};

	i2c0: i2c@0 {
		compatible = "mstar,swi2c";
		iic-mode = <1>;     /* i2c-mode: 0:swi2c; 1:hwi2c */
		bus-index = <0>;    /* swi2c setting: bus index */
		sda-gpio = <55>;    /* swi2c setting: sda pad */
		scl-gpio = <54>;    /* swi2c setting: scl pad */
		def-delay = <100>;  /* swi2c setting: clk */
		hw-port = <3>;      /* hwi2c setting: port */
		pad-mux = <25>;     /* hwi2c setting: pad mux */
		speed-khz = <100>;  /* hwi2c setting: clk */
		retries = <5>;      /* Unused */
		status = "okay";    /* Unused */
	};

	i2c1: i2c@1 {
		compatible = "mstar,swi2c";
		iic-mode = <0>;     /* i2c-mode: 0:swi2c; 1:hwi2c */
		bus-index = <1>;    /* swi2c setting: bus index */
		sda-gpio = <143>;   /* swi2c setting: sda pad */
		scl-gpio = <142>;   /* swi2c setting: scl pad */
		def-delay = <100>;  /* swi2c setting: clk */
		hw-port = <0>;      /* hwi2c setting: port */
		pad-mux = <0>;      /* hwi2c setting: pad mux */
		speed-khz = <100>;  /* hwi2c setting: clk */
		retries = <5>;      /* Unused */
		status = "okay";    /* Unused */
	};

	i2c2: i2c@2 {
		compatible = "mstar,swi2c";
		iic-mode = <0>;     /* i2c-mode: 0:swi2c; 1:hwi2c */
		bus-index = <2>;    /* swi2c setting: bus index */
		sda-gpio = <139>;   /* swi2c setting: sda pad */
		scl-gpio = <135>;   /* swi2c setting: scl pad */
		def-delay = <100>;  /* swi2c setting: clk */
		hw-port = <0>;      /* hwi2c setting: port */
		pad-mux = <0>;      /* hwi2c setting: pad mux */
		speed-khz = <100>;  /* hwi2c setting: clk */
		retries = <5>;      /* Unused */
		status = "okay";    /* Unused */
	};

	stepper_motor:stepper_motor {
		status = "disabled";
	};

	spi0:spi@0x153A {
		status = "disabled";
	};

    keypad: keypad{
		compatible = "mtk,hq-keypad";
		reg = <0 0x1f002800 0 0x200>;
		interrupts = <0x0 0x1 0x4>;
		mtk,keypad-chanel = <1>;
		mtk,keypad-lowbd = <848>;
		mtk,keypad-upwbd = <1023>;
		mtk,keypad-num = <8>;
		linux,input-no-autorepeat;
		wakeup-source;

		key_1 {
			linux,code = <0x8b>;
			keypad,threshold = <0x339>;
		};

		key_2 {
			linux,code = <0x4F>;
			keypad,threshold = <0x2DB>;
		};

		key_3 {
			linux,code = <0x1C>;
			keypad,threshold = <0x275>;
		};

		key_4 {
			linux,code = <0x72>;
			keypad,threshold = <0x210>;
		};

		key_5 {
			linux,code = <0x73>;
			keypad,threshold = <0x175>;
		};

		key_6 {
			linux,code = <0x193>;
			keypad,threshold = <0xF9>;
		};

		key_7 {
			linux,code = <0x192>;
			keypad,threshold = <0x81>;
		};

		key_8 {
			linux,code = <0x74>;
			keypad,threshold = <0x0>;
		};
	};

	mmc_host_sdio:mmc_host_sdio {
		compatible = "mstar, sdio";
		sdio-padmux = <1>;
		cd-option = <1>,<0x322D>,<0x64>,<2>;
		wp-option = <2>,<0x322F>,<0x24>,<2>;
		pc-option = <1>,<0x322F>,<0x08>,<0>;
		sdio-volt-type = <0>;
		sdio-fast-connect = <0>;
	};

	buf_tag {
	/* heaptype: HEAP_TYPE_IOMMU = 0, HEAP_TYPE_CMA= 1,  HEAP_TYPE_CMA_IOMMU = 2*/
	/* miutype:  UMA_OR_MIU0 = 0, MIU_1 = 1 */
		vdec_fb {
			id = <1>;
			heaptype = <0>;
			max_size = <0x0 0x10E00000>;
			miu = <0>;
			normal_zone = <0>;
			cache = <2>;
		};
		vdec_es {
			id = <2>;
			heaptype = <0>;
			max_size = <0x0 0x03000000>;
			miu = <0>;
			normal_zone = <0>;
			cache = <2>;
		};
		xc_main {
			id = <3>;
			heaptype = <3>;
			max_size = <0x0 0x5F00000>;
			miu = <0>;
			normal_zone = <0>;
			cache = <2>;
		};
		xc_sub {
			id = <74>;
			heaptype = <0>;
			max_size = <0x0 0x1800000>;
			miu = <0>;
			normal_zone = <1>;
			cache = <2>;
		};
		xc_hse {
			id = <4>;
			heaptype = <0>;
			max_size = <0x0 0x1000000>;
			miu = <0>;
			normal_zone = <1>;
			cache = <2>;
		};
		mali_gop_dma: mali_gop_dma {
			id = <5>;
			heaptype = <0>;
			max_size = <0x0 0x6000000>;
			miu = <0>;
			normal_zone = <0>;
			cache = <2>;
		};
		mali_gop {
			id = <6>;
			heaptype = <0>;
			max_size = <0x0 0x19000000>;
			miu = <0>;
			normal_zone = <1>;
			cache = <2>;
		};
		gpu_workbuf {
			id = <47>;
			heaptype = <0>;
			max_size = <0x0 0x1000000>;
			miu = <0>;
			normal_zone = <0>;
			cache = <2>;
		};
		gpu_outputbuf {
			id = <77>;
			heaptype = <0>;
			max_size = <0x0 0x2001000>;
			miu = <0>;
			normal_zone = <0>;
			cache = <2>;
		};
		dip_capture {
			id = <54>;
			heaptype = <0>;
			max_size = <0x0 0x3000000>;
			miu = <0>;
			normal_zone = <0>;
			cache = <2>;
		};
		xc_frc_pq {
			id = <7>;
			heaptype = <0>;
			max_size = <0x0 0xf00000>;
			miu = <0>;
			normal_zone = <0>;
			cache = <2>;
		};
		xc_frc_l {
			id = <8>;
			heaptype = <3>;
			max_size = <0x0 0x6600000>;
			miu = <0>;
			normal_zone = <0>;
			cache = <2>;
		};
		img_frame {
			id = <9>;
			heaptype = <0>;
			max_size = <0x0 0x2000000>;
			miu = <0>;
			normal_zone = <1>;
			cache = <2>;
		};
		mheg_write {
			id = <75>;
			heaptype = <0>;
			max_size = <0x0 0x2000000>;
			miu = <0>;
			normal_zone = <0>;
			cache = <2>;
		};
		mheg_read {
			id = <74>;
			heaptype = <0>;
			max_size = <0x0 0x500000>;
			miu = <0>;
			normal_zone = <0>;
			cache = <2>;
		};
		mheg_inter {
			id = <76>;
			heaptype = <0>;
			max_size = <0x0 0xD00000>;
			miu = <0>;
			normal_zone = <0>;
			cache = <2>;
		};
		jpd_write {
			id = <10>;
			heaptype = <0>;
			max_size = <0x0 0x2000000>;
			miu = <0>;
			normal_zone = <0>;
			cache = <2>;
		};
		jpd_read {
			id = <11>;
			heaptype = <0>;
			max_size = <0x0 0x500000>;
			miu = <0>;
			normal_zone = <0>;
			cache = <2>;
		};
		jpd_inter {
			id = <12>;
			heaptype = <0>;
			max_size = <0x0 0xD00000>;
			miu = <0>;
			normal_zone = <0>;
			cache = <2>;
		};
		disp_photo {
			id = <13>;
			heaptype = <0>;
			max_size = <0x0 0x4000000>;
			miu = <0>;
			normal_zone = <0>;
			cache = <2>;
		};
		directfb_frame0 {
			id = <14>;
			heaptype = <0>;
			max_size = <0x0 0x8000000>;
			miu = <0>;
			normal_zone = <1>;
			cache = <2>;
		};
		directfb_frame1 {
			id = <15>;
			heaptype = <0>;
			max_size = <0x0 0x1200000>;
			miu = <0>;
			normal_zone = <1>;
			cache = <2>;
		};
		tsp_pvr {
			id = <16>;
			heaptype = <0>;
			max_size = <0x0 0x0D80000>;
			miu = <0>;
			normal_zone = <1>;
			cache = <2>;
		};
		tsr_ginga {
			id = <78>;
			heaptype = <0>;
			max_size = <0x0 0x0800000>;
			miu = <0>;
			normal_zone = <1>;
			cache = <2>;
        };
		tsp_filein {
			id = <17>;
			heaptype = <0>;
			max_size = <0x0 0x0240000>;
			miu = <0>;
			normal_zone = <1>;
			cache = <2>;
		};
		tsp_fiq {
			id = <18>;
			heaptype = <0>;
			max_size = <0x0 0x402000>;
			miu = <0>;
			normal_zone = <1>;
			cache = <2>;
		};
		tsp_alppvr {
			id = <19>;
			heaptype = <0>;
			max_size = <0x0 0x0C00000>;
			miu = <0>;
			normal_zone = <1>;
			cache = <2>;
		};
		fbdev {
			id = <86>;
			heaptype = <0>;
			max_size = <0x0 0x4000000>;
			miu = <0>;
			normal_zone = <0>;
			cache = <2>;
		};
		cap_once {
			id = <81>;
			heaptype = <0>;
			max_size = <0x0 0x0800000>;
			miu = <0>;
			normal_zone = <0>;
			cache = <2>;
		};
		cap_once_ge {
			id = <82>;
			heaptype = <0>;
			max_size = <0x0 0x0800000>;
			miu = <0>;
			normal_zone = <0>;
			cache = <2>;
		};
		cap_more {
			id = <83>;
			heaptype = <0>;
			max_size = <0x0 0x0C00000>;
			miu = <0>;
			normal_zone = <0>;
			cache = <2>;
		};
		mmutils_cap {
			id = <80>;
			heaptype = <0>;
			max_size = <0x0 0x0C00000>;
			miu = <0>;
			normal_zone = <0>;
			cache = <2>;
		};
		factory_osd {
			id = <85>;
			heaptype = <0>;
			max_size = <0x0 0x0800000>;
			miu = <0>;
			normal_zone = <0>;
			cache = <2>;
		};
	};

	ehci_1:Mstar-ehci-1 {
		compatible = "Mstar-ehci-1";
	};

	ehci_2:Mstar-ehci-2 {
		compatible = "Mstar-ehci-2";
	};

	ehci_3:Mstar-ehci-3 {
		compatible = "Mstar-ehci-3";
	};

	ehci_4:Mstar-ehci-4 {
		compatible = "Mstar-ehci-4";
	};

    soc-dvfs {
        enable =  <1>;
        package = <1>;
        cluster = <1>;
        cluster_0 {
            cpu-info {
                partid =    <0xd03>;
                mask   =    <0x0>;
                freqaddr =  <0x1F200A04>;
                anabank =   <0x110c00>;
                mcubank =   <0x101d00>;
            };
            table-info_0 {
                sys-info {
                    default-clock = <1150>;
                    min-clock =     <1150>;
                    max-clock =     <1500>;
                    boost-clock =   <1500>;
                    antutu-clock =  <1500>;
                    protect-clock = <850>;
                    default-cpu =   <100>;
                    default-core =  <100>;
                    max-cpu =       <120>;
                    min-cpu =       <90>;
                };
                temp-info {
                    freeze_lower =  <0xffff>;
                    freeze_upper =  <0xffff>;
                    normal_lower =  <120>;
                    normal_upper =  <135>;
                    reset =         <150>;
                    power-ss    =   <90>;
                    power-ff    =   <90>;
                };
                core-info {
                    min-clock =     <600>;
                    max-clock =     <600>;
                    power-ss =      <100>;
                    power-ff =      <95>;
                };
                clock-info {
                    level = <3>;
                    pairs {
                        setting_0 {
                            min-clock = <1150>;
                            max-clock = <1350>;
                            power-ss =  <100>;
                            power-ff =  <95>;
                        };
                        setting_1 {
                            min-clock = <1350>;
                            max-clock = <1500>;
                            power-ss =  <107>;
                            power-ff =  <102>;
                        };
                        setting_2 {
                            min-clock = <1500>;
                            max-clock = <1501>;
                            power-ss =  <115>;
                            power-ff =  <110>;
                        };
                    };
                };
                power_info: power-info {
                    type = "i2c";
                    parm {
                        set =       "hw";
                        port =      <3>;
                        slave-id =  <0x80>;
                        id =        <0x9a>;
                        shift =     <1>;
                        step =      <3>;
                    };
                };
            };
        };
    };
};
